       target="_blank"
       style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:.95rem;letter-spacing:1px;text-transform:uppercase;background:var(--green);color:#000;padding:12px 24px;text-decoration:none;display:inline-block;transition:opacity .2s">
