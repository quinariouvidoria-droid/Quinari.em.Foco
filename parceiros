    <a href="mailto:quinari.ouvidoria@gmail.com?subject=Interesse%20em%20patrocinar%20o%20Quinari%20em%20Foco"
       style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:.95rem;letter-spacing:1px;text-transform:uppercase;background:var(--bg2);color:var(--white);border:1px solid var(--border);padding:12px 24px;text-decoration:none;display:inline-block">
